# ========================================================
# Cloudflare Credentials Configuration Template
# DO NOT COMMIT REAL SECRETS TO GIT
# ========================================================

# 1. Your Cloudflare Account ID (Found on Cloudflare dashboard right sidebar)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# 2. Cloudflare API Token for Pages Deployment
# Generated from Cloudflare Dashboard > My Profile > API Tokens > "Cloudflare Pages: Edit"
CLOUDFLARE_API_TOKEN=your_pages_api_token_here

# 3. Cloudflare R2 S3-Compatible Credentials
# Generated from Cloudflare Dashboard > R2 Storage > Manage R2 API Tokens > "Object Read & Write"
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=flip-releases

# 4. Supabase Backend Integration (Optional)
# For real email OTP/password reset and cloud synchronization
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
